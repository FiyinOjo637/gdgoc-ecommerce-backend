# Copy this file to .env and fill in real values before running the app.

# --- Database ---
# SQLite by default (zero setup). For production, point this at Postgres, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/gdgoc_ecommerce?schema=public"
# and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth (JWT) ---
# Use long, random values in real deployments, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Payments (Paystack sandbox) ---
# Get a free test secret key from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack redirects the browser after payment (Scenario D)
FRONTEND_CALLBACK_URL=http://localhost:3000/checkout/callback

# --- Inventory reservation (Scenario F) ---
RESERVATION_TTL_MINUTES=15
# How often the reservation-expiry + reconciliation background jobs run
RECONCILIATION_POLL_INTERVAL_MS=60000

# --- Seed data ---
ADMIN_SEED_EMAIL=admin@gdgoc.dev
ADMIN_SEED_PASSWORD=Admin123!
