{
  "name": "gdgoc-ecommerce-backend",
  "version": "1.0.0",
  "description": "Mini E-Commerce Backend - GDGoC Bowen University Technical Lead Assessment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r dotenv/config dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node -r dotenv/config src/db/migrate.ts",
    "db:seed": "ts-node -r dotenv/config src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "pretest": "cross-env NODE_ENV=test dotenv -e .env.test -- ts-node src/db/migrate.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand --config jest.config.js",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@types/yamljs": "^0.2.34",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.24.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
